# Copie para .env e ajuste. Os valores padrão são os mesmos do backend Java.
PORT=3000

# PostgreSQL — o MESMO banco usado pelo Spring Boot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techservices
DB_USER=postgres
DB_PASSWORD=postgres

# Alternativa: uma única URL. Aceita postgres://... ou a mesma DB_URL JDBC do Java
# (jdbc:postgresql://localhost:5432/techservices).
# DB_URL=postgres://postgres:postgres@localhost:5432/techservices

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Insere o catálogo inicial de serviços quando a tabela estiver vazia
SEED_ENABLED=true
